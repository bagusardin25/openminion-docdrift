# Copy to .env and fill in the key for the provider you use. .env is git-ignored.
# Gemini (default):           uv run docdrift init
GEMINI_API_KEY=
# OpenAI:                     uv run docdrift init --provider openai
OPENAI_API_KEY=
# Cortensor Portal:           uv run docdrift init --provider cortensor-portal --model oss-20b --agent docdrift-portal
#                             (create a key at https://portal.cortensor.network)
CORTENSOR_API_KEY=
