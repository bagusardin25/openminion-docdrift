+def test_agent_reports_schema_error_of_recovered_json_object() -> None:
+    # The runtime prefixes replies with "<agent>: ", so the raw text is never
+    # valid JSON. The recovered object is missing "summary"; that is the error
+    # callers need, not "Invalid JSON at line 1 column 1".
+    reply = 'agent: {"sentiment": "neutral"}'
+    agent = Agent(output_type=_ReplyModel, runtime=_FakeRuntime(reply))
+    with pytest.raises(AgentOutputValidationError) as exc_info:
+        agent.run("evaluate")
+    errors = exc_info.value.validation_error.errors()
+    assert [(e["type"], e["loc"]) for e in errors] == [("missing", ("summary",))]
+    assert "json_invalid" not in str(exc_info.value)
+    assert exc_info.value.raw_text == reply
+
+
 def test_agent_raises_validation_error_on_unparseable_reply() -> None:
     runtime = _FakeRuntime("not json at all")
     agent = Agent(output_type=_ReplyModel, runtime=runtime)
